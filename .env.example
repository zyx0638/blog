# 复制为 .env.local 并填写（.env.local 已被 gitignore，不会提交）

# 管理员密码：首次运行 npm run db:seed 时用它创建 admin 账号
ADMIN_PASSWORD=

# 管理员用户名（可选，默认 admin）
ADMIN_USERNAME=admin

# 会话签名密钥：至少 32 字节，用 `openssl rand -base64 32` 生成
SESSION_SECRET=

# 数据库文件路径（可选，默认 data/blog.db）
# DB_PATH=./data/blog.db

# Bangumi API 代理（可选）：大陆网络直连 api.bgm.tv 会遭遇 DNS 污染，
# 需经代理访问（如本机 Clash http://127.0.0.1:7897），未设置则直连
# BANGUMI_PROXY=http://127.0.0.1:7897
